<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neuedu.employee.mapper.EmployeeMapper">

    <select id="selectByRealname" resultType="com.neuedu.employee.entity.Employee">
        select id,realname,password,deptment_id,regist_level_id,scheduling_id,delmark
        from employee
        where realname = #{realname}
    </select>

    <select id="selectAll" resultType="com.neuedu.employee.entity.Employee">
        select id,realname,deptment_id,regist_level_id,scheduling_id,delmark
        from employee
        where delmark = 1
        order by id
    </select>

</mapper>
