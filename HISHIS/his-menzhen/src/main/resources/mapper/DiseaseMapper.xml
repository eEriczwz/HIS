<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neuedu.outpatient.mapper.DiseaseMapper">
    <resultMap id="BaseResultMap" type="com.neuedu.outpatient.entity.Disease">
        <id column="id" property="id"/>
        <result column="disease_code" property="diseaseCode"/>
        <result column="disease_name" property="diseaseName"/>
        <result column="diseaseICD" property="diseaseICD"/>
        <result column="disease_category" property="diseaseCategory"/>
    </resultMap>

    <!-- 通过病历id查询所有疾病：medical_record_disease 联 disease -->
    <select id="selectByMedicalRecordId" resultMap="BaseResultMap">
        SELECT d.* FROM disease d
        INNER JOIN medical_record_disease mrd ON d.id = mrd.disease_id
        WHERE mrd.medical_record_id = #{medicalRecordId}
    </select>

    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT * FROM disease WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
