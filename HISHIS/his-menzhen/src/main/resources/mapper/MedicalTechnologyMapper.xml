<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neuedu.outpatient.mapper.MedicalTechnologyMapper">
    <resultMap id="BaseResultMap" type="com.neuedu.outpatient.entity.MedicalTechnology">
        <id column="id" property="id"/>
        <result column="tech_code" property="techCode"/>
        <result column="tech_name" property="techName"/>
        <result column="tech_format" property="techFormat"/>
        <result column="tech_price" property="techPrice"/>
        <result column="tech_type" property="techType"/>
        <result column="price_type" property="priceType"/>
        <result column="deptment_id" property="deptmentId"/>
    </resultMap>

    <select id="selectByType" resultMap="BaseResultMap">
        SELECT * FROM medical_technology
        <where>
            <if test="techType != null and techType != ''">
                tech_type = #{techType}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (tech_name LIKE CONCAT('%', #{keyword}, '%')
                     OR tech_code LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY id
        LIMIT 100
    </select>
</mapper>
